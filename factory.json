{
  "name": "salon",
  "one_liner": "Live waiting board and salon console: one-screen operator entry, admin back office, public wait count.",
  "blueprint": "web-app",
  "version": "0.1.0",
  "check": ["lint", "typecheck", "test", "build", "audit"],
  "stopOnFail": true,
  "commands": {
    "install": "npm install",
    "lint": "",
    "typecheck": "npx tsc --noEmit",
    "test": "npm test",
    "build": "npm run build",
    "audit": "npm audit --audit-level=high",
    "run": "npm run dev",
    "release": "npx vercel deploy --prod --yes"
  }
}
